{
  "name": "pinterest-for-woocommerce",
  "title": "Pinterest for WooCommerce",
  "version": "1.5.2",
  "description": "Pinterest for WooCommerce",
  "author": "WooCommerce",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "pinterest for wordpress",
    "pinterest for woocommerce",
    "wordpress",
    "wordpress plugin",
    "woocommerce",
    "woocommerce integration",
    "pinterest",
    "pinterest integration",
    "wordpress pinterest integration",
    "woocommerce pinterest integration"
  ],
  "homepage": "https://woocommerce.com/products/pinterest-for-woocommerce/",
  "repository": {
    "type": "git",
    "url": "git@github.com:woocommerce/pinterest-for-woocommerce.git"
  },
  "bugs": {
    "url": "https://github.com/woocommerce/pinterest-for-woocommerce/issues"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "main": "gulpfile.js",
  "dependencies": {
    "@woocommerce/components": "^5.1.2",
    "@woocommerce/navigation": "^5.2.0",
    "@woocommerce/tracks": "^1.1.0",
    "@wordpress/api-fetch": "^3.23.0",
    "@wordpress/components": "^12.0.8",
    "@wordpress/compose": "^3.13.1",
    "@wordpress/data": "^4.27.1",
    "@wordpress/data-controls": "^2.1.2",
    "@wordpress/element": "^2.13.1",
    "@wordpress/hooks": "^2.12.0",
    "@wordpress/i18n": "^3.11.0",
    "@wordpress/icons": ">=5.0.0 <6.0.0",
    "@wordpress/notices": "^2.12.7",
    "@wordpress/url": "^3.1.1",
    "classnames": "^2.2.6",
    "lodash": "^4.18.0"
  },
  "devDependencies": {
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "@woocommerce/dependency-extraction-webpack-plugin": "~2.2.0",
    "@woocommerce/e2e-utils-playwright": "0.5.1",
    "@woocommerce/eslint-plugin": "^4.0.0",
    "@wordpress/base-styles": "^3.6.0",
    "@wordpress/env": "11.15.0",
    "@wordpress/scripts": "^36.1.0",
    "@wordpress/stylelint-config": "^25.0.0",
    "browser-sync": "^3.0.4",
    "eslint": "^10.10.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-cached": "^1.1.1",
    "gulp-clean-css": "^4.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-filter": "^5.1.0",
    "gulp-load-plugins": "^2.0.8",
    "gulp-plumber": "^1.2.1",
    "gulp-rename": "^1.4.0",
    "gulp-sass": "^6.0.1",
    "gulp-size": "^3.0.0",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-uglify": "^3.0.2",
    "gulp-vinyl-zip": "^2.1.2",
    "jsdom": "^26.1.0",
    "merge-stream": "^1.0.1",
    "minimist": "^1.2.8",
    "prettier": "npm:wp-prettier@^3.9.6",
    "process": "^0.11.10",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-scss": "^7.3.0",
    "through2": "^4.0.2",
    "typescript": "^5.9.3",
    "underscore": "^1.9.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "prebuild": "composer install",
    "build": "wp-scripts build && gulp build && npm run i18n",
    "build:zip": "npm run build && composer install --no-dev -n && gulp zip",
    "postbuild:zip": "composer install && npm run _remove-root-md && mkdir -p deploy && mv $npm_package_name.zip deploy/",
    "_remove-root-md": "zipinfo -1 pinterest-for-woocommerce.zip | grep -E '^pinterest-for-woocommerce/[^/]+\\.md$' | xargs zip -d pinterest-for-woocommerce.zip || true",
    "dev": "wp-scripts build && gulp build",
    "format:js": "wp-scripts format ./assets/source",
    "i18n": "WP_CLI_PHP_ARGS='-d memory_limit=2048M' ./vendor/bin/wp i18n make-pot ./ i18n/languages/$npm_package_name.pot --slug=$npm_package_name --domain=$npm_package_name --exclude='bin,*.asset.php,assets/source/_maps,assets/setup-*,assets/catalog-sync,assets/build,tests,woo-tracking-jsdoc,index.php,gulpfile.js,vitest.config.mjs'",
    "changelog": "composer install --quiet && composer exec -- changelogger",
    "changelog:check": "bash bin/check_changelog.sh",
    "lint:css": "wp-scripts lint-style \"./assets/source/**/*.{css,scss}\"",
    "lint:css:fix": "wp-scripts lint-style \"./assets/source/**/*.{css,scss}\" --fix",
    "lint:js": "wp-scripts lint-js ./assets/source ./tests/browser",
    "lint:js:fix": "wp-scripts lint-js ./assets/source ./tests/browser --fix",
    "lint:tooling-js": "wp-scripts lint-js gulpfile.js webpack.config.js vitest.config.mjs eslint.config.cjs",
    "lint:tooling-js-fix": "npm run lint:tooling-js -- --fix",
    "lint:md:docs": "wp-scripts lint-md-docs --dot",
    "check-licenses": "wp-scripts check-licenses --ignore=@woocommerce/components,@woocommerce/csv-export,@woocommerce/currency,@woocommerce/data,@woocommerce/date,@woocommerce/experimental,@woocommerce/navigation,@woocommerce/tracks",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "lint:composer": "composer validate --no-check-all --no-check-publish",
    "lint:php": "composer run-script phpcs ./",
    "lint:php:fix": "composer run-script phpcbf",
    "start": "wp-scripts start",
    "test:js": "wp-scripts test-unit-js --coverage",
    "test:js:watch": "npm run test:js -- --watch",
    "test:php": "npm run test:php-prepare -- wordpress_test root root localhost && npm run test:php-run",
    "test:php-prepare": "./bin/install-wp-tests.sh",
    "test:php-run": "composer test-unit",
    "test:php:wp-env": "wp-env run tests-cli bash /var/www/html/wp-content/plugins/pinterest-for-woocommerce/bin/phpunit-wp-env.sh",
    "wp-env": "wp-env",
    "test:browser": "playwright test --config tests/browser/playwright.config.js",
    "test:browser:setup": "bash tests/browser/setup.sh",
    "test:browser:reset": "node tests/browser/reset.js",
    "audit:npm": "npm audit --package-lock-only --audit-level=high --include=dev",
    "audit:composer": "composer audit --locked --no-plugins --no-scripts --abandoned=report --ignore-severity=low --ignore-severity=medium"
  },
  "stylelint": {
    "extends": [
      "@wordpress/stylelint-config/scss"
    ],
    "rules": {
      "no-descending-specificity": null,
      "selector-class-pattern": null,
      "unit-allowed-list": [
        "em",
        "px",
        "%",
        "s",
        "rem",
        "vw",
        "vh",
        "ms",
        "fr"
      ],
      "scss/load-no-partial-leading-underscore": null,
      "value-keyword-case": [
        "lower",
        {
          "ignoreKeywords": [
            "currentColor"
          ]
        }
      ]
    }
  },
  "browserslist": [
    "last 5 versions",
    "> 1%",
    "maintained node versions",
    "not dead"
  ],
  "config": {
    "wp_org_slug": "pinterest-for-woocommerce",
    "version_replace_paths": [
      "includes",
      "src",
      "bin",
      "class-pinterest-for-woocommerce.php",
      "pinterest-for-woocommerce.php",
      "uninstall.php"
    ]
  },
  "overrides": {
    "qs@^6.0.0": "^6.16.0",
    "@babel/runtime@^7.0.0": "^7.26.10",
    "@babel/runtime-corejs2@^7.0.0": "^7.26.10",
    "moment@^2.0.0": "^2.29.4",
    "lodash": "$lodash",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@wordpress/scripts": {
      "markdownlint-cli": {
        ".": "^0.49.1",
        "js-yaml": "5.4.2"
      }
    },
    "copy-webpack-plugin": {
      "serialize-javascript": "^7.0.3"
    },
    "@woocommerce/number@^2.0.0": "^2.6.0",
    "@wp-g2/create-styles": {
      "rtlcss": "^4.3.0"
    },
    "uuid@>=7 <9": "^11.1.1",
    "isomorphic-fetch@^2.0.0": "^3.0.0",
    "d3-color@^1.0.0": "^3.1.0",
    "gulp-sourcemaps": {
      "css": "npm:@adobe/css-tools@^4.5.0"
    },
    "postcss-selector-parser": "7.1.6",
    "smol-toml": "1.9.0"
  }
}
