parameters:
	ignoreErrors:
		-
			message: '#^Action callback returns Automattic\\WooCommerce\\Pinterest\\Tracking\|false but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: class-pinterest-for-woocommerce.php

		-
			message: '#^Action callback returns array but should not return anything\.$#'
			identifier: return.void
			count: 2
			path: class-pinterest-for-woocommerce.php

		-
			message: '#^Action callback returns bool but should not return anything\.$#'
			identifier: return.void
			count: 2
			path: class-pinterest-for-woocommerce.php

		-
			message: '#^Variable \$errors in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: class-pinterest-for-woocommerce.php

		-
			message: '#^Class Automattic\\WooCommerce\\Admin\\Features\\Navigation\\Menu not found\.$#'
			identifier: class.notFound
			count: 2
			path: includes/admin/class-pinterest-for-woocommerce-admin.php

		-
			message: '#^Class Automattic\\WooCommerce\\Admin\\Features\\Navigation\\Screen not found\.$#'
			identifier: class.notFound
			count: 1
			path: includes/admin/class-pinterest-for-woocommerce-admin.php

		-
			message: '#^Filter callback return statement is missing\.$#'
			identifier: return.missing
			count: 1
			path: includes/admin/class-pinterest-for-woocommerce-admin.php

		-
			message: '#^Action callback returns mixed but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: src/AdCredits.php

		-
			message: '#^Action callback returns mixed but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: src/Billing.php

		-
			message: '#^Action callback returns array but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: src/CommerceIntegration.php

		-
			message: '#^Action callback returns bool but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: src/FeedRegistration.php

		-
			message: '#^Call to an undefined method WC_Data_Store\:\:get_notes_with_name\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Notes/FeedDeletionFailure.php

		-
			message: '#^Static method Automattic\\WooCommerce\\Pinterest\\Notes\\Collection\\AbstractNote\:\:should_be_added\(\) invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Notes/MarketingNotifications.php

		-
			message: '#^Access to an undefined property WC_Shipping_Method\:\:\$requires\.$#'
			identifier: property.notFound
			count: 1
			path: src/PinterestShippingZone.php

		-
			message: '#^Call to an undefined method WC_Product\:\:get_variation_regular_price\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/ProductsXmlFeed.php

		-
			message: '#^Action callback returns true but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: src/RefreshToken.php

		-
			message: '#^Variable \$product in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: src/SaveToPinterest.php

		-
			message: '#^Call to an undefined method WC_Data_Store\:\:get_zones\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Shipping.php

		-
			message: '#^Call to an undefined method WC_Order_Item\:\:get_total\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Tracking.php

		-
			message: '#^Callback expects 1 parameter, \$accepted_args is set to 2\.$#'
			identifier: arguments.count
			count: 1
			path: src/Tracking.php

		-
			message: '#^Callback expects 4 parameters, \$accepted_args is set to 6\.$#'
			identifier: arguments.count
			count: 1
			path: src/Tracking.php

		-
			message: '#^Function wp_has_consent not found\.$#'
			identifier: function.notFound
			count: 1
			path: src/WPConsentAPI.php
